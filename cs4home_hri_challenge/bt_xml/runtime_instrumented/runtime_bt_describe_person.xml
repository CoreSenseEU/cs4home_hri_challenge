<root main_tree_to_execute="BehaviorTree">
    <BehaviorTree ID="BehaviorTree">
        <Sequence>
            <Action ID="RuntimeTrace" event="capability_executable" capability="Describe / Invite" architecture="bt" />
            <Action ID="RuntimeTrace" event="first_bt_action_start" capability="Describe / Invite" architecture="bt" />
            <Action ID="InitReceptionist" cam_frame="{cam_frame}" manipulation_frame="{man_frame}" host_name="{h_name}" host_drink="{h_drink}" current_guest="{n}" attention_home="{attention_home}" />
            <Action ID="EnableDetectByIdentity" enable="false" />
            <Action ID="Speak" say_text="Please follow me, i will get you to the  party, please stay behind me" />
            <Action ID="LookAt" tf_frame="{attention_home}" />
            <Action ID="LookAt" tf_frame="{attention_home}" />
            <Action ID="SetTorsoHeight" height="0.3" />
            <Action ID="RuntimeTrace" event="last_bt_action_finish" capability="Describe / Invite" architecture="bt" />
            <Action ID="RuntimeTrace" event="capability_finished" capability="Describe / Invite" architecture="bt" />
            <Action ID="RuntimeTrace" event="transition_to_next" capability="Describe / Invite" architecture="bt" />
        </Sequence>
    </BehaviorTree>
</root>