<root main_tree_to_execute="BehaviorTree">
    <BehaviorTree ID="BehaviorTree">
        <Sequence>
            <Action ID="RuntimeTrace" event="capability_executable" capability="Find Seat" architecture="bt" />
            <Action ID="RuntimeTrace" event="first_bt_action_start" capability="Find Seat" architecture="bt" />
            <Action ID="InitReceptionist" cam_frame="{cam_frame}" manipulation_frame="{man_frame}" host_name="{h_name}" host_drink="{h_drink}" current_guest="{n}" attention_home="{attention_home}" />
            <Action ID="Speak" say_text="come here" />
            <Action ID="GetAttendedGuest" guest_attended="{guest_attending}" />
            <Action ID="RemoveStringPrefix" string_to_remove="{guest_attending}" prefix="guest" result="{n}" />
            <Action ID="Speak" say_text="I'll find you a seat" />
            <Sequence>
                <RetryUntilSuccessful num_attempts="-1">
                    <Fallback>
                        <Timeout msec="30000">
                            <ReactiveFallback>
                                <Condition ID="IsSittable" cam_frame="{cam_frame}" chair_frame="{chair_frame}" />
                                <Action ID="Pan" period="20.0" range="45" pitch_angle="-5" />
                            </ReactiveFallback>
                        </Timeout>
                        <Sequence>
                            <Action ID="Explain" question="IsSittable" auto_triggered="true" explanation="{explain_text}" />
                            <Action ID="Speak" say_text="{explain_text}" />
                            <AlwaysFailure />
                        </Sequence>
                    </Fallback>
                </RetryUntilSuccessful>
                <Action ID="LookAt" tf_frame="{chair_frame}" />
                <Action ID="PointAt" tf_frame="{chair_frame}" base_frame="base_link" low_z="0.6" high_z="0.9" />
                <Action ID="Speak" say_text="Please, sit over there" />
                <Delay delay_msec="500">
                    <Action ID="PlayMotionPredefined" motion_name="home" />
                </Delay>
                <Action ID="LookAt" tf_frame="{attention_home}" />
            </Sequence>
            <Action ID="SetTorsoHeight" height="0.3" />
            <Action ID="RuntimeTrace" event="last_bt_action_finish" capability="Find Seat" architecture="bt" />
            <Action ID="RuntimeTrace" event="capability_finished" capability="Find Seat" architecture="bt" />
            <Action ID="RuntimeTrace" event="transition_to_next" capability="Find Seat" architecture="bt" />
        </Sequence>
    </BehaviorTree>
</root>